// Refusal or unusable observation; none supplies fallback account data.
type AccountInspectionFailure = variant {
  // Inconsistent local state.
  Internal;
  // Invalid positive bounds or principal.
  Invalid;
  // Installed scope, response account or source mismatch.
  Binding;
  // Platform did not enqueue the read.
  NotEnqueued;
  // Malformed, over-budget or invalid provider figures.
  InvalidReply;
  // A restored owner cannot initiate or complete provider observations.
  Fenced;
  // Raw platform rejection code.
  Rejected : nat32;
  // Actual caller is not the operator.
  Denied;
  // Reply exceeds the application byte budget.
  ReplyTooLarge;
};
// Explicit observation kind; account and owner come from the installed scope.
type AccountInspectionKind = variant {
  // Reported relationship between the service owner and installed payer.
  PaymentRelationship;
  // Reported payer balances.
  Balance;
};
// Operator-selected read, never arbitrary provider arguments.
type AccountInspectionRequest = record {
  // One independently requested observation, not an atomic account snapshot.
  kind : AccountInspectionKind;
  // Exact installed scope checked before dispatch and again after the await.
  scope : OperatorScope;
};
// Reply bound to this exact invocation; not persisted or usable as a funding permit.
type AccountInspectionResponse = record {
  // Exact request, including installed scope and selected observation kind.
  request : AccountInspectionRequest;
  // Independently validated provider observation.
  observation : AccountObservation;
};
// Account reports and structured provider errors remain distinct from transport failure.
type AccountObservation = variant {
  // No compatible relationship returned; optional subtyping can also cause this.
  NoRelationshipReported;
  // Provider reported no balance account; never a zero balance.
  AccountNotFound;
  // Provider-reported missing relationship; diagnostic principal is not authority.
  RelationshipNotFound : principal;
  // Provider-reported authorization error.
  NotAuthorized : principal;
  // Provider internal failure, without exposing diagnostic text.
  ProviderInternalError;
  // Provider rejected the request, without exposing diagnostic text.
  InvalidRequest;
  // Independently reported balance components, not proof of payment credit.
  Balance : FundingReportedBalance;
  // Present relationship matching both expected principals.
  Relationship : AccountRelationshipView;
};
// Provider relationship figures retained without arithmetic or sentinel interpretation.
type AccountRelationshipView = record {
  // Uninterpreted provider creation timestamp.
  added_timestamp : nat64;
  // Signed daily limit, not assumed to be an allowance.
  spending_limit_per_day : int;
  // Exact paid canister, checked against the service.
  paid_canister : principal;
  // Arbitrary-width reported downloaded baseline.
  bandwidth_baseline_downloaded : nat;
  // Optional provider expiry; absence grants no perpetual authority.
  expiration_timestamp : opt nat64;
  // Signed reported spend.
  current_period_spent : int;
  // Uninterpreted provider period start.
  current_period_start : nat64;
  // Provider baseline timestamp.
  bandwidth_baseline_ts_ns : nat64;
  // Exact expected payer, checked independently.
  payment_account : principal;
  // Arbitrary-width reported uploaded baseline.
  bandwidth_baseline_uploaded : nat;
};
// Successful `_immutableObjectStorageCreateCertificate` response, matching the
// reviewed Caffeine Mixin. This record alone is neither a signed certificate nor
// proof of provider acceptance, completed upload, or billing behavior.
type CaffeineUploadCertificateResponse = record {
  // Exactly `upload` for the supported operation.
  method : text;
  // Canonical provider root bound to the original admitted upload.
  blob_hash : text;
};
// Descriptor refusal; no error authorizes body disclosure, retry of paid effects
// or release of the consumer's reference.
type DownloadFailure = variant {
  // Stored invariants could not be established.
  Internal;
  // Malformed or zero identity.
  Invalid;
  // Tenant is absent or suspended.
  Inactive;
  // Service, namespace or configured serving identity differs.
  Binding;
  // Restored installation refuses operational delivery.
  Fenced;
  // Caller is not the named tenant.
  Denied;
  // No confirmed content with that exact live reference.
  Unavailable;
};
// Original accepted hash metadata; HTTP response headers must not replace it.
type DownloadHeader = record {
  // Original header value.
  value : text;
  // Original header name.
  name : text;
};
// Exact tenant-owned reference, never an allocation or a publication lease.
type DownloadRequest = record {
  // Intended storage service, also checked against actual execution.
  "service" : principal;
  // Nonzero object identity.
  object : nat;
  // Caffeine tree root, not a raw-content digest.
  root : blob;
  // Nonzero currently live reference.
  reference : nat;
  // Nonzero exact object lifetime.
  incarnation : nat;
  // Must equal the endpoint's authenticated caller.
  tenant : principal;
  // Explicit local namespace; never a provider project identifier.
  namespace : nat;
};
// A current observation. Consumers must authenticate delivery and coordinate
// publication/reference lifetime; saved descriptors are not revocation mechanisms.
type DownloadResponse = record {
  // Storage owner, independent of payer and tenant.
  owner : principal;
  // Complete request echoed by the same synchronous observation.
  request : DownloadRequest;
  // First-accepted metadata in its retained order/spelling.
  headers : vec DownloadHeader;
  // Declared exact nonzero body length.
  bytes : nat64;
  // Explicit provider project; no origin or credential is returned.
  project : text;
};
// Balance component whose decoding or amount validation failed.
type FundingBalanceField = variant {
  // Prepaid balance.
  Prepaid;
  // Total balance.
  Total;
  // Ledger balance.
  Ledger;
  // Promotional balance.
  Promotional;
};
// Descending local operation position, never a snapshot or retry permission.
type FundingHistoryCursor = record {
  // Complete original journal scope.
  scope : OperatorScope;
  // Exclusive positive upper bound for the next operation.
  before_operation : nat;
};
// Original identity and amounts recovered without a saved caller request.
type FundingHistoryEntry = record {
  // Full retained scope, not a caller-selected transport destination.
  scope : OperatorScope;
  // Exact optional target balance; absence is never defaulted.
  target_balance : opt nat;
  // Positive lifetime local operation identity; not a provider receipt ID.
  operation : nat;
  // Retained local progress only.
  phase : FundingPhase;
  // Original positive cycle attachment, independent of execution fees.
  offered : nat;
};
// Inspection refusals never become empty history or retry permission.
type FundingHistoryFailure = variant {
  // Retained records cannot be read consistently.
  Internal;
  // Zero namespace or continuation identity.
  Invalid;
  // Actual service or requested journal scope differs from installation.
  Binding;
  // Actual caller is not the configured operator.
  Denied;
  // Cursor belongs to a different journal scope.
  CursorScope;
};
// Bounded current observations, newest local operation first.
type FundingHistoryPage = record {
  // Restored journal permits inspection only.
  fenced : bool;
  // Complete request echoed for correlation.
  request : FundingHistoryRequest;
  // Absent only at the end of this local range, not proof of account completeness.
  next : opt FundingHistoryCursor;
  // Exact local observations; no provider call or reconciliation is implied.
  entries : vec FundingHistoryEntry;
};
// One operator history query with host-owned result bounds.
type FundingHistoryRequest = record {
  // Continuation; resweep to observe activity behind this position.
  cursor : opt FundingHistoryCursor;
  // Explicit installed service, namespace, Cashier and payer.
  scope : OperatorScope;
};
// Exact inspection refusal; absence is returned separately and never permits retry.
type FundingOutcomeFailure = variant {
  // Retained state cannot be read consistently.
  Internal;
  // Zero namespace, operation, offer or present target balance.
  Invalid;
  // Wrong actual service or installed scope.
  Binding;
  // Caller is not the configured operator.
  Denied;
  // Retained intent differs from the supplied original amounts/options.
  Conflict;
};
// Complete original local intent; changed amounts or target options must reject.
type FundingOutcomeRequest = record {
  // Installed service, namespace, Cashier and payer.
  scope : OperatorScope;
  // Exact optional positive target balance; no inferred default.
  target_balance : opt nat;
  // Positive local operation identity, not a provider receipt ID.
  operation : nat;
  // Original positive attachment, excluding execution fees.
  offered : nat;
};
// One retained local observation; no field authorizes retry or unfencing.
type FundingOutcomeResponse = record {
  // Restored journal permits inspection only.
  fenced : bool;
  // Complete original intent checked before disclosure.
  request : FundingOutcomeRequest;
  // Absent when no structured response was durably retained.
  response : opt FundingResponse;
  // Local transport progress.
  phase : FundingPhase;
  // Independent diagnosis; a success report cannot clear accepted attachment.
  reconciliation : FundingReconciliation;
};
// Local attachment progress, separate from any provider response or credit.
type FundingPhase = variant {
  // Attempt marked; full attachment remains potentially spent.
  Uncertain;
  // Trusted local observation proves the call was not enqueued.
  NotEnqueued;
  // Exact callback refund; accepted remainder is not proof of provider credit.
  Callback : record {
    // Cycles returned in the exact callback, bounded by the original offer.
    refunded : nat;
  };
  // Attachment reserved before a local attempt marker.
  Prepared;
};
// Conservative follow-up derived only from retained attachment facts.
type FundingReconciliation = variant {
  // Full original attachment remains potentially spent.
  TransferUnknown : nat;
  // Exact transport acceptance still requires independent provider-credit evidence.
  CreditRequired : nat;
  // No attached cycles transferred; execution fees are separate.
  NoTransfer;
};
// Provider-reported balance components, never a credited-amount receipt.
type FundingReportedBalance = record {
  // Reported total.
  total : nat;
  // Reported prepaid cycles.
  prepaid : nat;
  // Reported ledger cycles.
  ledger : nat;
  // Reported promotional cycles.
  promotional : nat;
};
// Retained structured response, independent of the exact callback refund.
type FundingResponse = variant {
  // Validated reported balance, not proof of credit or freshness.
  ReportedSuccess : FundingReportedBalance;
  // The platform did not enqueue a call.
  NotEnqueued;
  // Malformed, incompatible or over-budget Candid.
  InvalidReply;
  // The prepared call was consumed without polling it.
  NotDispatched;
  // Provider-reported principal, not caller authority.
  NotAuthorized : principal;
  // Raw IC rejection code, without diagnostic text.
  Rejected : nat32;
  // Reported balance component could not be represented or validated.
  InvalidBalance : FundingBalanceField;
  // Reply exceeded the configured decoding byte budget.
  ReplyTooLarge;
  // Provider-reported balance overflow; refund accounting stays independent.
  AccountBalanceOverflow;
  // Provider internal error; diagnostic text is discarded.
  InternalError;
  // Provider reported no attached cycles; local transport facts stay authoritative.
  TopUpWithoutCycles;
};
// Rejected revocations leave membership and pending work unchanged.
type GatewayRevocationFailure = variant {
  // Retained registry cannot be read consistently.
  Internal;
  // Zero namespace or anonymous/management gateway principal.
  Invalid;
  // Wrong actual service or installed service/provider/account scope.
  Binding;
  // Restored registry remains inspection-only.
  Fenced;
  // Actual caller is not the configured operator.
  Denied;
};
// One current operator decision to revoke a gateway from this installation.
// Repeating it is another revocation, not replay of a historical receipt; it can
// remove membership added since an earlier call. Clients must not retry silently.
type GatewayRevocationRequest = record {
  // Complete installed service/namespace/Cashier/payer scope.
  scope : OperatorScope;
  // Concrete gateway principal to revoke, including an already absent member.
  gateway : principal;
};
// Synchronous acknowledgment, not a retained receipt or provider-side settlement.
type GatewayRevocationResponse = record {
  // Exact operator decision applied by the service.
  request : GatewayRevocationRequest;
  // Whether the principal was a member before this decision. Pending sync and
  // read observations are invalidated even when this is false.
  removed : bool;
};
// Cancel exactly one observed pending read-only sync, never a paid operation.
type GatewaySyncCancellation = record {
  // Complete installed service/provider/account scope.
  scope : OperatorScope;
  // Positive pending identity obtained from local status.
  sequence : nat64;
};
// Typed failure; transport/decoding failures preserve pending work for inspection.
type GatewaySyncFailure = variant {
  // Retained state could not be read consistently.
  Internal;
  // Local sync sequence cannot advance.
  Exhausted;
  // Zero namespace/cancellation identity or invalid host transport configuration.
  Invalid;
  // Another sync is already pending.
  Busy;
  // Scope, actual service or authenticated transport source differs.
  Binding;
  // Platform refused to enqueue the provider query; pending sync is retained.
  NotEnqueued;
  // Malformed, over-budget, empty or invalid membership reply.
  InvalidReply;
  // Restored registry remains inspection-only.
  Fenced;
  // Raw platform rejection, including bounded-wait uncertainty.
  Rejected : nat32;
  // Actual caller is not the configured operator.
  Denied;
  // Reply exceeds the host's transport/decoder byte budget.
  ReplyTooLarge;
  // The original pending sync was cancelled, revoked, completed or replaced.
  Conflict;
};
// Acknowledgment of one completed local membership replacement.
// Inspect local status after an uncertain reply; do not automatically start again.
type GatewaySyncResponse = record {
  // Complete original installed scope.
  scope : OperatorScope;
  // Local sync identity, never independent freshness or provider authority.
  sequence : nat64;
};
// Operator-only installed configuration and local restore state.
type HostConfigurationView = record {
  // Restored stores allow inspection only; false is not provider readiness.
  fenced : bool;
  // Package release bound to this installation, not a module hash.
  release : text;
  // Exact installed configuration; observation performs no provider calls.
  configuration : ServiceConfigurationInput;
  // Explicit installed verifier, independent of gateway membership.
  completion_verifier : principal;
  // Immutable installed provider project, independent of the payer and tenants.
  project : text;
};
// Inspection authority rejection.
type HostFailure = variant {
  // Caller is not the configured operator; controller status is insufficient.
  Denied;
};
// Complete standalone installation, with an explicit provider project mapping.
// Validation checks representation only; it does not provision a Caffeine project.
type HostInstallationInput = record {
  // Shared service identity, tenant/resource bounds and provider economics.
  configuration : ServiceConfigurationInput;
  // Trusted external whole-content verifier; no controller or operator default.
  completion_verifier : principal;
  // Provider project mapped to this service's local namespace; never inferred.
  project : text;
};
// Complete maintained totals for this local funding journal only.
type LocalFundingStatus = record {
  // Retained lifetime intents, including terminal outcomes.
  retained_intents : nat64;
  // Transport-accepted attachments; not necessarily credited by the provider.
  transport_accepted : nat;
  // Funding owner refuses mutations after restoration.
  fenced : bool;
  // Lifetime exact refunds, already included in available allocation.
  refunded : nat;
  // Highest retained identity; not a restore-safe allocator.
  last_operation : opt nat;
  // Attachment whose transport outcome remains absent.
  reserved_or_uncertain : nat;
  // Remaining attachment allocation including its reserve.
  available_allocation : nat;
  // Remaining attachment allowance after reserve; never dispatch authority.
  attachment_allowance : nat;
  // Lifetime proven unsent attachments, not callback refunds.
  not_enqueued : nat;
  // Installed lifetime intent capacity.
  intent_capacity : nat64;
};
// One bounded membership row, not evidence of deployed provider authorization.
type LocalGatewayStatus = record {
  // Installed principals in retained order, at most 1024.
  members : vec principal;
  // Gateway owner refuses mutations after restoration.
  fenced : bool;
  // Last allocated local sync identity, including invalidated attempts.
  last_sequence : nat64;
  // Outstanding local read-only sync.
  pending_sequence : opt nat64;
};
// Occupied read slots survive interruption; inspection does not release them.
type LocalReadStatus = record {
  // Read owner refuses admission and completion after restoration.
  fenced : bool;
  // Highest locally allocated session identity.
  last_sequence : nat64;
  // Occupied sessions, including abandoned callbacks.
  sessions : nat32;
  // Reserved transport response buffers.
  reserved_bytes : nat64;
};
// One synchronous local snapshot. No provider call or history traversal occurs.
// Separate fences remain visible; none of these observations authorize dispatch.
type LocalServiceStatus = record {
  // Upload reservations and continuing object obligations.
  uploads : LocalUploadStatus;
  // Independently checked full request scope.
  scope : OperatorScope;
  // Bounded installed membership and local sync state.
  gateways : LocalGatewayStatus;
  // Retained concurrent read occupancy.
  reads : LocalReadStatus;
  // Local attachment allocation; not platform liquidity or provider credit.
  funding : LocalFundingStatus;
};
// Local inspection refusal; failures never become empty or zero observations.
type LocalStatusFailure = variant {
  // Retained accounting or registry state cannot be read consistently.
  Internal;
  // Actual/requested scope or assembled owners differ.
  Binding;
  // Caller is not the configured operator.
  Denied;
};
// Maintained upload counters, including cancelled/settled lifetime history.
type LocalUploadStatus = record {
  // Continuing billing-liability bytes, including reservations.
  liability_bytes : nat;
  // Logical bytes, including reservations.
  logical_bytes : nat;
  // Upload owner refuses mutations after restoration.
  fenced : bool;
  // Lifetime operation slots; cancellation does not free these.
  operations : nat64;
  // Reserved or possibly exposed uploads.
  active_reservations : nat64;
  // Physical bytes, including reservations.
  physical_bytes : nat;
  // Bytes reserved by these active uploads.
  reserved_bytes : nat;
};
// Complete installed service/provider/account scope for explicit operator requests.
type OperatorScope = record {
  // Actual storage service.
  "service" : principal;
  // Installed Cashier, not a caller-selected transport destination.
  cashier : principal;
  // Installed payer account.
  payment_account : principal;
  // Positive installed local namespace.
  namespace : nat;
};
// Exact reference operation kind.
type ReferenceAction = variant {
  // Release the named reference.
  Release;
  // Retain the named reference.
  Retain;
};
// Correlated observation, not reservation, liveness or mutation authority.
type ReferenceCapacityResponse = record {
  // Restored owner allows inspection only, including when headroom is absent.
  fenced : bool;
  // Exact original tenant/root request.
  request : UploadDiscoveryRequest;
  // Absent for unknown, foreign or unconfirmed roots; never proof of global absence.
  headroom : opt ReferenceHeadroom;
};
// Original successful transition; it says nothing about current liveness.
type ReferenceChange = variant {
  // The original operation required no change.
  Unchanged;
  // The original operation changed the reference.
  Changed;
};
// Passive exact intent shared by mutation and receipt lookup. Persist before dispatch.
type ReferenceCommand = record {
  // Exact original action.
  action : ReferenceAction;
  // Reference targeted by the operation.
  reference : nat;
  // Original confirmed upload.
  upload : ReferenceUpload;
  // Exact operation identity, independent of upload and reference IDs.
  operation : nat;
};
// Admission/lookup refusal, distinct from a recorded transition failure.
type ReferenceFailure = variant {
  // Inconsistent storage or an unexpected internal result.
  Internal;
  // Invalid identity or declaration.
  Invalid;
  // Upload has not completed.
  Unconfirmed;
  // Fresh retain requires active enrollment. Exact replay and release remain allowed.
  Inactive;
  // Service or namespace differs from the installed owner.
  Binding;
  // Restored owner permits inspection only, including for exact mutation retries.
  Fenced;
  // No unreserved receipt slot; cleanup reservations remain protected.
  Capacity;
  // Actual caller is not the named tenant.
  Denied;
  // No matching upload operation is retained.
  Unknown;
  // Existing identity has different original arguments.
  Conflict;
};
// Independent lifetime capacity dimensions, without allocating a reference or receipt.
type ReferenceHeadroom = record {
  // Fresh distinct retains permitted by these counters and lifecycle only.
  // Enrollment, identity, scope and restore checks still apply at mutation time.
  fresh_retains : nat64;
  // Receipt slots not already reserved for cleanup.
  unreserved_receipts : nat64;
  // Cleanup receipt slots reserved for active references.
  release_reserved_receipts : nat64;
  // Unused lifetime reference identities.
  reference_slots : nat64;
};
// Exact original result plus whether this call recorded it or replayed history.
type ReferenceMutationResponse = record {
  // True only when this call returned an already recorded result.
  replayed : bool;
  // Original transition result, including an admitted lifecycle failure.
  receipt : ReferenceReceiptResponse;
};
// Explicit presence avoids Candid optional-value coercion hiding malformed data.
type ReferenceReceiptLookup = variant {
  // The exact original transition result.
  Found : ReferenceReceiptResponse;
  // No receipt in this owner; never permission to repeat an uncertain operation.
  Absent;
};
// Exact recorded outcome. Historical success cannot authorize publication.
type ReferenceReceiptResponse = record {
  // Original success or failure, preserved across subsequent transitions.
  result : Result_1;
  // Complete original request, checked before disclosure by the client.
  request : ReferenceCommand;
};
// Tenant-owned lookup, with no mutation operation or action to replay.
type ReferenceStatusRequest = record {
  // Exact positive reference identity to inspect.
  reference : nat;
  // Complete original upload binding, including independent object/first-reference IDs.
  upload : ReferenceUpload;
};
// One synchronous retained-state observation, never a serving or mutation lease.
type ReferenceStatusResponse = record {
  // The same upload owner's restore fence; even a live reference cannot bypass it.
  fenced : bool;
  // Full request echoed for correlation.
  request : ReferenceStatusRequest;
  // Whether this exact reference is currently active in local retained state.
  // False covers both never-retained and released references, not reusable identity.
  live : bool;
};
// Retained failure of an admitted operation, not failure to look up its receipt.
type ReferenceTransitionFailure = variant {
  // Lifetime reference capacity was exhausted.
  Limit;
  // Object deletion had already queued.
  DeletionQueued;
  // The reference had already been released.
  Released;
  // No such reference existed at the time.
  UnknownReference;
};
// Complete original upload binding. Upload and object IDs are independent.
type ReferenceUpload = record {
  // Storage service canister.
  "service" : principal;
  // Object identity.
  object : nat;
  // Immutable provider root.
  root : blob;
  // Object lifetime.
  incarnation : nat;
  // Original upload operation.
  upload : nat;
  // Original declared nonzero length.
  bytes : nat64;
  // Tenant project canister.
  tenant : principal;
  // Local provider namespace.
  namespace : nat;
  // First reference admitted with the upload.
  first_reference : nat;
};
type Result = variant {
  Ok : UploadAdmissionMutation;
  Err : UploadAdmissionFailure;
};
type Result_1 = variant {
  Ok : ReferenceChange;
  Err : ReferenceTransitionFailure;
};
type Result_10 = variant { Ok : LocalServiceStatus; Err : LocalStatusFailure };
type Result_11 = variant {
  Ok : UploadDiscoveryResponse;
  Err : UploadDiscoveryFailure;
};
type Result_12 = variant {
  Ok : UploadManifestMutation;
  Err : UploadManifestFailure;
};
type Result_13 = variant {
  Ok : ReferenceCapacityResponse;
  Err : UploadDiscoveryFailure;
};
type Result_14 = variant {
  Ok : ReferenceReceiptLookup;
  Err : ReferenceFailure;
};
type Result_15 = variant {
  Ok : ReferenceStatusResponse;
  Err : ReferenceFailure;
};
type Result_16 = variant {
  Ok : GatewayRevocationResponse;
  Err : GatewayRevocationFailure;
};
type Result_17 = variant {
  Ok : UploadRevocationResponse;
  Err : UploadAdmissionFailure;
};
type Result_18 = variant { Ok : GatewaySyncResponse; Err : GatewaySyncFailure };
type Result_19 = variant { Ok : TenantEnrollmentResponse; Err : TenantFailure };
type Result_2 = variant {
  Ok : ReferenceMutationResponse;
  Err : ReferenceFailure;
};
type Result_20 = variant {
  Ok : UploadAdmissionResponse;
  Err : UploadAdmissionFailure;
};
type Result_21 = variant {
  Ok : UploadAttestationResponse;
  Err : UploadAttestationFailure;
};
type Result_22 = variant {
  Ok : UploadCapacityResponse;
  Err : UploadCapacityFailure;
};
type Result_23 = variant {
  Ok : UploadCertificateAssessmentResponse;
  Err : UploadExposureFailure;
};
type Result_24 = variant {
  Ok : UploadHistoryPage;
  Err : FundingHistoryFailure;
};
type Result_25 = variant {
  Ok : UploadManifestResponse;
  Err : UploadManifestFailure;
};
type Result_26 = variant {
  Ok : UploadStatusResponse;
  Err : UploadStatusFailure;
};
type Result_27 = variant {
  Ok : UploadVerificationPlan;
  Err : UploadAttestationFailure;
};
type Result_3 = variant {
  Ok : UploadAttestationMutation;
  Err : UploadAttestationFailure;
};
type Result_4 = variant { Ok; Err : GatewaySyncFailure };
type Result_5 = variant { Ok : HostConfigurationView; Err : HostFailure };
type Result_6 = variant { Ok : DownloadResponse; Err : DownloadFailure };
type Result_7 = variant {
  Ok : FundingHistoryPage;
  Err : FundingHistoryFailure;
};
type Result_8 = variant {
  Ok : opt FundingOutcomeResponse;
  Err : FundingOutcomeFailure;
};
type Result_9 = variant {
  Ok : AccountInspectionResponse;
  Err : AccountInspectionFailure;
};
// Explicit provider identity and local cycle thresholds, with no service defaults.
type ServiceBillingInput = record {
  // Positive minimum provider balance.
  minimum_balance : nat;
  // Configured Cashier candidate; validation does not prove deployed behavior.
  cashier : principal;
  // Positive local cycle reserve.
  reserve : nat;
  // Positive target balance, at least the minimum.
  target_balance : nat;
  // Distinct gateway principals retained after validation.
  max_gateway_unique : nat32;
  // Raw gateway-list entries including duplicates.
  max_gateway_entries : nat32;
};
// Candidate configuration for a separately authorized host installation.
// No defaults, deployment authorization, provider namespace proof or mutation is implied.
type ServiceConfigurationInput = record {
  // Exact intended canister, checked against the host's actual identity.
  "service" : principal;
  // Explicit upload/catalog envelope; counts are portable to Wasm32.
  resources : ServiceResourceInput;
  // Explicit operator; controllers do not gain tenant authority.
  operator : principal;
  // Candidate Cashier and local funding policy; no payment is performed.
  billing : ServiceBillingInput;
  // Selected payer account; a different payer needs separate relationship proof.
  payment_account : principal;
  // Concurrent read occupancy and response buffer budgets.
  reads : ServiceReadInput;
  // Positive local namespace identity, not a provisioned gateway project/bucket.
  namespace : nat;
  // Separate local attachment allocation and retained funding history bound.
  funding : ServiceFundingInput;
};
// Local attachment budget, not platform liquidity or provider credit.
type ServiceFundingInput = record {
  // Total lifetime attachment allocation in cycles.
  allocated : nat;
  // Positive amount kept out of attachment offers within this allocation.
  reserve : nat;
  // Positive lifetime journal capacity, including uncertain and completed attempts.
  max_attempts : nat32;
};
// Explicit concurrent read bounds; abandoned sessions continue consuming capacity.
type ServiceReadInput = record {
  // Maximum response buffer reserved by one session.
  reply_bytes : nat32;
  // Reserved response buffer bytes per tenant.
  tenant_bytes : nat64;
  // Simultaneous slots per tenant.
  tenant_sessions : nat32;
  // Global simultaneous session slots.
  sessions : nat32;
  // Global reserved response buffer bytes.
  bytes : nat64;
};
// Positive resource limits; conversion also checks all existing model relationships.
type ServiceResourceInput = record {
  // Framed metadata bytes per manifest.
  max_header_bytes : nat32;
  // Lifetime receipt slots per object, including reserved cleanup capacity.
  max_receipts_per_object : nat32;
  // Global concurrent upload reservations.
  max_active : nat32;
  // Concurrent upload reservations per tenant.
  max_tenant_active : nat32;
  // Metadata entries per manifest.
  max_headers : nat32;
  // Global lifetime object slots.
  max_objects : nat32;
  // Global byte budget for continuing billing obligations.
  max_liability_bytes : nat;
  // Lifetime tenant slots, including suspended entries.
  max_tenants : nat32;
  // Lifetime reference slots per object.
  max_references_per_object : nat32;
  // Largest admitted object in bytes.
  max_object_bytes : nat64;
  // Tenant logical-byte budget.
  max_tenant_logical_bytes : nat;
  // Global lifetime retained leaf slots.
  max_chunks : nat32;
  // Lifetime retained leaf slots per tenant.
  max_tenant_chunks : nat32;
  // Lifetime object slots per tenant.
  max_tenant_objects : nat32;
  // Global stored-byte budget, including unreconciled obligations.
  max_physical_bytes : nat;
};
// Passive current enrollment, also used as an exact update precondition.
type TenantEnrollment = record {
  // Fresh admission is enabled; suspension preserves obligations and cleanup.
  active : bool;
  // Positive local activation generation; not a restore-safe allocation authority.
  generation : nat64;
};
// Correlated observation, not a durable operation receipt or upload permission.
type TenantEnrollmentResponse = record {
  // This owner is inspection-only after restoration.
  fenced : bool;
  // Original requested service, namespace and tenant.
  scope : TenantScope;
  // Current enrollment, absent only for a never-enrolled tenant.
  enrollment : opt TenantEnrollment;
};
// Typed refusal without granting authority or erasing tenant history.
type TenantFailure = variant {
  // Inconsistent retained state or unexpected internal result.
  Internal;
  // Invalid tenant principal or zero expected generation.
  Invalid;
  // Wrong running service or installed namespace.
  Binding;
  // Restored owners reject all updates, including no-ops.
  Fenced;
  // All lifetime tenant slots are occupied, including suspended entries.
  Capacity;
  // Mutation requires the operator; inspection requires the operator or tenant.
  Denied;
  // Reactivation cannot increment the generation; suspension remains possible.
  GenerationExhausted;
  // Current enrollment differs from the expected state; inspect before retrying.
  Conflict;
};
// Exact service namespace and tenant; supplied identity alone grants no authority.
type TenantScope = record {
  // Intended running storage service.
  "service" : principal;
  // Tenant project, never inferred from the operator or controller.
  tenant : principal;
  // Positive installed local provider namespace.
  namespace : nat;
};
// Operator-authorized compare-and-set; inspect after a lost reply before deciding again.
type TenantUpdateRequest = record {
  // Desired admission state; suspended tenants still consume lifetime capacity.
  active : bool;
  // Exact observed enrollment; `None` requires a never-enrolled tenant.
  expected : opt TenantEnrollment;
  // Exact destination and tenant.
  scope : TenantScope;
};
// Admission/inspection refusal; missing history never proves safe provider retry.
type UploadAdmissionFailure = variant {
  // Inconsistent storage or an unexpected internal result.
  Internal;
  // Malformed identity, uploader or object length.
  Invalid;
  // Tenant is not enrolled or is suspended for fresh admission.
  Inactive;
  // Wrong installed service or namespace.
  Binding;
  // Restored owner permits inspection only.
  Fenced;
  // Configured object, history, reservation or byte capacity is exhausted.
  Capacity;
  // Caller is not the named tenant.
  Denied;
  // Exact operation has no retained permission.
  Unknown;
  // Fresh permission's exclusive deadline has passed.
  Expired;
  // Existing operation, root or object has conflicting arguments.
  Conflict;
};
// Result of a synchronous local reservation, with no certificate or provider call.
type UploadAdmissionMutation = record {
  // Existing permission was observed without renewing it or reserving more capacity.
  replayed : bool;
  // Exact retained permission and phase.
  admission : UploadAdmissionResponse;
};
// Immutable permission. Persist every field before dispatch; IDs are caller allocated.
type UploadAdmissionRequest = record {
  // Complete original upload and first-reference identity.
  upload : ReferenceUpload;
  // Explicit uploader, distinct from tenant admission authority.
  uploader : principal;
  // Exclusive issuance deadline in IC nanoseconds; retries never extend it.
  expires_at_ns : nat64;
};
// Exact retained permission and historical phase, not issuance or serving authority.
type UploadAdmissionResponse = record {
  // Complete original permission, checked on both admission and inspection.
  permission : UploadAdmissionRequest;
  // Local permission was withdrawn; escaped effects may remain uncertain.
  revoked : bool;
  // Current retained phase; confirmation remains historical after release.
  state : UploadState;
};
// No failure authorizes a new upload or discards uncertain provider effects.
type UploadAttestationFailure = variant {
  // Upload is not exposed with a prepared manifest, or existing host-only confirmation lacks this receipt.
  Phase;
  // Observation predates admission or lies in the future.
  Observation;
  // Caller is not the explicit verifier (or an allowed receipt observer).
  Denied;
  // Original permission or store rejection.
  Permission : UploadAdmissionFailure;
  // A different statement was already accepted for this exact upload.
  Conflict;
};
// Read-only exact permission lookup, available through restore fencing.
type UploadAttestationLookup = variant {
  // Immutable statement, including after reference release or settlement.
  Found : UploadAttestationReceipt;
  // No verifier statement retained; not retry or exposure authority.
  Absent;
};
// Successful atomic confirmation or exact replay.
type UploadAttestationMutation = record {
  // First accepted immutable evidence.
  receipt : UploadAttestationReceipt;
  // False for an exact replay; no reference is reactivated.
  changed : bool;
};
// First accepted verifier evidence. Historical confirmation does not grant current liveness.
type UploadAttestationReceipt = record {
  // Authenticated installed verifier that supplied it.
  verifier : principal;
  // Exact original statement.
  request : UploadAttestationRequest;
  // Service acceptance time; exact retry preserves this value.
  accepted_at_ns : nat64;
};
// Save this exact statement before sending. Changed statements cannot replace a receipt.
type UploadAttestationRequest = record {
  // Full original permission, root, length and object/reference identities.
  permission : UploadAdmissionRequest;
  // Verifier's observation time in IC nanoseconds, not a retention deadline.
  observed_at_ns : nat64;
  // Raw SHA-256 of independently fetched and root-verified content.
  content_digest : blob;
};
// Attestation observation and the upload owner's restore fence.
type UploadAttestationResponse = record {
  // Full exact permission echo, also when evidence is absent.
  permission : UploadAdmissionRequest;
  // Read-only restore fence; a false value does not grant dispatch authority.
  fenced : bool;
  // Original receipt, never synthesized from current lifecycle state.
  attestation : UploadAttestationLookup;
};
// Refusal to inspect capacity, never an implicit zero or permission to upload.
type UploadCapacityFailure = variant {
  // Retained state or counter conversion is inconsistent.
  Internal;
  // Invalid tenant principal or zero namespace.
  Invalid;
  // No retained enrollment exists for this tenant.
  NotEnrolled;
  // Service or namespace differs from the installed owner.
  Binding;
  // Caller differs from the explicitly named tenant.
  Denied;
};
// Current tighter global/tenant headroom, including retained provider liabilities.
type UploadCapacityResponse = record {
  // Configured per-object framed metadata byte limit.
  max_header_bytes : nat64;
  // Remaining lifetime operation/root slots; cleanup never refunds history.
  remaining_objects : nat64;
  // Configured per-object metadata entry limit.
  max_headers : nat64;
  // Restored owner permits inspection only, regardless of positive headroom.
  fenced : bool;
  // Remaining concurrent reservations, including possibly exposed uploads.
  remaining_active_uploads : nat64;
  // Exact authenticated service, namespace and tenant.
  scope : TenantScope;
  // Remaining lifetime retained leaf slots.
  remaining_manifest_chunks : nat64;
  // Suspension preserves inspection while preventing fresh admission.
  enrollment : TenantEnrollment;
  // Configured per-object byte ceiling, independent of remaining bytes.
  max_object_bytes : nat64;
  // Minimum logical, physical and continuing-billing byte headroom.
  remaining_bytes : nat;
};
// Exact uploader-only preparation assessment. This snapshot cannot authorize a
// later update; issuance rechecks the original permission and current host facts.
type UploadCertificateAssessmentResponse = record {
  // Original retained permission resolved from the provider root locator.
  permission : UploadAdmissionRequest;
  // Every missing prerequisite, independently represented.
  blockers : vec UploadExposureBlocker;
  // Host clock for this inspection; not a provider observation or lease.
  assessed_at_ns : nat64;
};
// Current local reservation or confirmed lifecycle.
type UploadContentState = variant {
  // No references remain; provider deletion unresolved.
  DeletionPending;
  // Unexposed local reservation.
  Reserved;
  // Confirmed content with live references.
  Live;
  // Physical deletion established; billing cessation unresolved.
  ProviderDeleted;
  // Escaped upload authority may have caused an effect.
  ExposurePossible;
  // Cancelled before exposure; identity remains retained.
  Cancelled;
  // Billing cessation established; history remains retained.
  Settled;
};
// Refusal must never be interpreted as an absent root.
type UploadDiscoveryFailure = variant {
  // Retained state could not be read consistently.
  Internal;
  // Invalid tenant or zero namespace.
  Invalid;
  // Wrong actual or installed service/namespace.
  Binding;
  // Actual caller is not the named tenant.
  Denied;
};
// Discover retained content without already knowing its operation identity.
type UploadDiscoveryRequest = record {
  // Provider root; a digest alone supplies no tenant authority.
  root : blob;
  // Actual tenant/service and installed namespace.
  scope : TenantScope;
};
// One synchronous local observation. Absence is not upload or retry permission.
type UploadDiscoveryResponse = record {
  // Complete original identity and current local state, visible only to its tenant.
  content : opt UploadHistoryEntry;
  // The owner's restore fence, independent of content visibility.
  fenced : bool;
  // Exact request echoed even for absent or foreign content.
  request : UploadDiscoveryRequest;
};
// A missing independent prerequisite for exposure or certificate issuance.
// A successful inspection with blockers is not upload authorization.
type UploadExposureBlocker = variant {
  // Certificate replay, lifetime or charging behavior is unqualified.
  ReplayCharging;
  // Provider owner/project/namespace binding is unqualified.
  ProviderNamespace;
  // Complete obligations and independent recovery freshness are unqualified.
  Recovery;
  // Atomic intent-before-effect durability is not established.
  Durability;
  // Host facts were not established in the current execution.
  StaleObservation;
  // Deployed size/tree/chunk enforcement before charging is unqualified.
  PrechargeLimits;
};
// Refused local exposure or historical permission inspection.
type UploadExposureFailure = variant {
  // Host evidence does not bind the entire original permission.
  EvidenceBinding;
  // No validated manifest is bound to the original permission.
  Unprepared;
  // Exposure already happened or the operation/clock no longer allows it.
  Phase;
  // Local issuance permission has been withdrawn.
  Revoked;
  // Full permission, authority, activation, deadline or restore fence failed.
  Permission : UploadAdmissionFailure;
};
// Untrusted forward position. Changes behind it require a fresh sweep.
type UploadHistoryCursor = record {
  // Original service.
  "service" : principal;
  // Last inspected operation; not necessarily a matching result.
  after_request : nat;
  // Tenant of the last inspected row.
  after_tenant : principal;
  // Original observer scope.
  scope : UploadHistoryScope;
  // Original filter.
  filter : UploadHistoryFilter;
  // Original local namespace.
  namespace : nat;
};
// Complete original upload identity with its current local lifecycle.
type UploadHistoryEntry = record {
  // Operation, object and first-reference IDs are independent.
  request : ReferenceUpload;
  // Current observation; not publication or retry authority.
  state : UploadContentState;
};
// Current local states to select, not a provider reconciliation result.
type UploadHistoryFilter = variant {
  // Every retained operation, including cancelled and settled history.
  All;
  // Last reference released, physical deletion unresolved.
  DeletionPending;
  // Active uploads or confirmed objects with unresolved obligations.
  Outstanding;
  // Reserved or possibly exposed uploads.
  Active;
};
// One bounded synchronous observation, available during inspection-only restore.
type UploadHistoryPage = record {
  // Restored upload owner permits inspection only.
  fenced : bool;
  // Full original request echoed for correlation.
  request : UploadHistoryRequest;
  // Advances past inspected history even when the result is empty.
  next : opt UploadHistoryCursor;
  // Operation rows inspected, including filtered-out rows.
  scanned : nat64;
  // Matching entries only; no manifests, credentials or file bytes.
  entries : vec UploadHistoryEntry;
};
// One scan; work and result limits are host-owned, never supplied by ingress.
type UploadHistoryRequest = record {
  // Actual intended storage service.
  "service" : principal;
  // Optional continuation, not a snapshot or completed sweep proof.
  cursor : opt UploadHistoryCursor;
  // Authority checked independently of the cursor.
  scope : UploadHistoryScope;
  // Current-state predicate.
  filter : UploadHistoryFilter;
  // Installed local namespace.
  namespace : nat;
};
// Independently authenticated observer scope.
type UploadHistoryScope = variant {
  // Caller must be this tenant, including while suspended.
  Tenant : principal;
  // Caller must be the installed operator.
  Service;
};
// Ordered leaf hashes and metadata, never complete content or raw-digest evidence.
type UploadManifestDeclaration = record {
  // Requires canonical Content-Length matching the immutable reservation.
  headers : vec DownloadHeader;
  // Ordered domain-separated chunk identities.
  chunks : vec blob;
};
// Failed preparation/inspection; uncertainty must preserve the original intent.
type UploadManifestFailure = variant {
  // Raw declaration exceeds configured count or byte bounds.
  Limit;
  // Leaves, metadata or declared root/length are inconsistent.
  Declaration;
  // Preparation is no longer permitted in the current phase or clock context.
  Phase;
  // Local issuance permission was withdrawn.
  Revoked;
  // Permission identity, authority, expiry, activation or restoration failure.
  Permission : UploadAdmissionFailure;
};
// Explicit absence prevents incompatible Candid optional data becoming unprepared.
type UploadManifestInspection = variant {
  // No declaration is retained; this does not authorize repeating uncertain effects.
  Unprepared;
  // Original accepted declaration, even after revocation, expiry or completion.
  Prepared : UploadManifestDeclaration;
};
// Successful local preparation, with no provider call or file transfer.
type UploadManifestMutation = record {
  // Original accepted declaration, always Prepared.
  observation : UploadManifestResponse;
  // False when an equivalent declaration was already bound.
  changed : bool;
};
// Save this complete intent before preparation dispatch; adapters bound ingress decoding.
type UploadManifestRequest = record {
  // Full original permission, including uploader and exclusive expiry.
  permission : UploadAdmissionRequest;
  // Declaration to validate against the admitted root and length.
  declaration : UploadManifestDeclaration;
};
// Authenticated historical observation, not issuance or publication authority.
type UploadManifestResponse = record {
  // Exact original permission.
  permission : UploadAdmissionRequest;
  // First accepted declaration; equivalent retries do not replace its metadata.
  manifest : UploadManifestInspection;
};
// Local permission withdrawal, distinct from reference release or provider deletion.
type UploadRevocationResponse = record {
  // Exact permission and retained phase; revocation must be true.
  admission : UploadAdmissionResponse;
  // Whether this call first withdrew the permission; false is an exact replay.
  changed : bool;
};
// Retained local upload phase; neither provider dispatch nor publication authority.
type UploadState = variant {
  // Reserved locally; upload authority has not escaped.
  Reserved;
  // Independently authenticated completion was applied and the first reference created.
  // This remains historical fact after release/deletion/settlement.
  Confirmed;
  // Upload authority may have escaped; effects remain uncertain.
  ExposurePossible;
  // Cancelled before exposure; retained identity is not reusable.
  Cancelled;
};
// Failed exact upload inspection. Absence does not authorize a fresh upload.
type UploadStatusFailure = variant {
  // Inconsistent internal storage.
  Internal;
  // Invalid original identity or length.
  Invalid;
  // Service/namespace differs from installed configuration.
  Binding;
  // Actual caller differs from the named tenant.
  Denied;
  // No retained upload under that operation identity.
  Unknown;
  // Retained operation has different original arguments.
  Conflict;
};
// Full original binding and current retained local state.
type UploadStatusResponse = record {
  // Local issuance permission has been withdrawn; escaped effects remain possible.
  revoked : bool;
  // Local lifecycle observation, not current reference liveness.
  state : UploadState;
  // Exact original upload, including its independent first reference identity.
  upload : ReferenceUpload;
};
// One authenticated observation for the installed verifier to inspect exposed bytes.
// No origin, credential, upload certificate or retry permission is supplied.
type UploadVerificationPlan = record {
  // Full original permission; independent identities must remain intact.
  permission : UploadAdmissionRequest;
  // Explicit installed verifier, independent of uploader and operator.
  verifier : principal;
  // Installed Caffeine owner, equal to this service.
  owner : principal;
  // Original root-consistent leaves and metadata, not provider response headers.
  declaration : UploadManifestDeclaration;
  // Original admission time; a verifier clock before this cannot attest.
  admitted_at_ns : nat64;
  // Installed provider project, never inferred from namespace or tenant.
  project : text;
};
service : (HostInstallationInput) -> {
  _immutableObjectStorageCreateCertificate : (text) -> (
      CaffeineUploadCertificateResponse,
    );
  blob_admit_upload : (UploadAdmissionRequest) -> (Result);
  blob_apply_reference : (ReferenceCommand) -> (Result_2);
  blob_attest_upload : (UploadAttestationRequest) -> (Result_3);
  blob_cancel_gateway_sync : (GatewaySyncCancellation) -> (Result_4);
  blob_configuration : () -> (Result_5) query;
  blob_download_descriptor : (DownloadRequest) -> (Result_6);
  blob_funding_history : (FundingHistoryRequest) -> (Result_7) query;
  blob_funding_outcome : (FundingOutcomeRequest) -> (Result_8) query;
  blob_inspect_account : (AccountInspectionRequest) -> (Result_9);
  blob_local_status : (OperatorScope) -> (Result_10) query;
  blob_lookup_content : (UploadDiscoveryRequest) -> (Result_11) query;
  blob_prepare_upload : (UploadManifestRequest) -> (Result_12);
  blob_reference_capacity : (UploadDiscoveryRequest) -> (Result_13) query;
  blob_reference_receipt : (ReferenceCommand) -> (Result_14) query;
  blob_reference_status : (ReferenceStatusRequest) -> (Result_15) query;
  blob_revoke_gateway : (GatewayRevocationRequest) -> (Result_16);
  blob_revoke_upload : (UploadAdmissionRequest) -> (Result_17);
  blob_sync_gateways : (OperatorScope) -> (Result_18);
  blob_tenant : (TenantScope) -> (Result_19) query;
  blob_update_tenant : (TenantUpdateRequest) -> (Result_19);
  blob_upload_admission : (UploadAdmissionRequest) -> (Result_20) query;
  blob_upload_attestation : (UploadAdmissionRequest) -> (Result_21) query;
  blob_upload_capacity : (TenantScope) -> (Result_22) query;
  blob_upload_certificate_assessment : (text) -> (Result_23) query;
  blob_upload_history : (UploadHistoryRequest) -> (Result_24) query;
  blob_upload_manifest : (UploadAdmissionRequest) -> (Result_25) query;
  blob_upload_status : (ReferenceUpload) -> (Result_26) query;
  blob_verification_manifest : (UploadAdmissionRequest) -> (Result_25) query;
  blob_verification_plan : (UploadAdmissionRequest) -> (Result_27) query;
}
