d4d27677fea26d6b98f3/skills%2Fwriting-motoko%2FSKILL.md","raw_url":"https://github.com/caffeinelabs/skills/raw/4ebf43c518c9fc7b090ed4d27677fea26d6b98f3/skills%2Fwriting-motoko%2FSKILL.md","contents_url":"https://api.github.com/repos/caffeinelabs/skills/contents/skills%2Fwriting-motoko%2FSKILL.md?ref=4ebf43c518c9fc7b090ed4d27677fea26d6b98f3","patch":"@@ -3,7 +3,7 @@ name: writing-motoko\n description: >-\n   Motoko language reference, architecture patterns, and dependency tooling\n   (mops). Load when writing or modifying backend .mo files.\n-version: 0.2.8\n+version: 0.2.9\n compatibility:\n   toolchain:\n     moc: \">=1.11.2\"\n@@ -223,8 +223,8 @@ let user = users.find(func u = u.id == caller)\n // Nested options — chain instead of nested switches\n let start = event.start.dateTime ?? event.start.date ?? \"\";\n \n-// RHS is lazy; may be a block. Bare record literals need extra braces/parens:\n-let n = opt ?? { let x = 1; x };\n+// RHS is lazy. A block needs `do`; a record literal needs parens:\n+let n = opt ?? do { let x = 1; x };\n let rec = opt ?? ({ x = 0 });\n ```\n "},{"sha":"e700d3040c4bbda5cb064b853dbd5994e87647d0","filename":"skills/writing-motoko/references/control-flow.md","status":"modified","additions":3,"deletions":3,"changes":6,"blob_url":"https://github.com/caffeinelabs/skills/blob/4ebf43c518c9fc7b090ed4d27677fea26d6b98f3/skills%2Fwriting-motoko%2Freferences%2Fcontrol-flow.md","raw_url":"https://github.com/caffeinelabs/skills/raw/4ebf43c518c9fc7b090ed4d27677fea26d6b98f3/skills%2Fwriting-motoko%2Freferences%2Fcontrol-flow.md","contents_url":"https://api.github.com/repos/caffeinelabs/skills/contents/skills%2Fwriting-motoko%2Freferences%2Fcontrol-flow.md?ref=4ebf43c518c9fc7b090ed4d27677fea26d6b98f3","patch":"@@ -18,10 +18,10 @@ let value = map.get(key) ?? Runtime.trap(\"Key not found\");\n // Nested options — chain instead of nested switches\n let start = event.start.dateTime ?? event.start.date ?? \"\";\n \n-// RHS may be a block (parsed as a block, not a record)\n-let n = opt ?? { let x = 1; x };\n+// A block on the RHS needs `do`\n+let n = opt ?? do { let x = 1; x };\n \n-// Bare record literal on the RHS needs extra braces or parens\n+// A record literal on the RHS needs parens\n let rec = opt ?? ({ x = 0 });\n ```\n "}]}