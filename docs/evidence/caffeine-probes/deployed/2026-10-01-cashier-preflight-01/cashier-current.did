  Ok : AccountBalanceGetResponse;
  Err : AccountBalanceGetError;
};
type AccountCycleBalances = record {
  total : int;
  cycles_prepaid : int;
  cycles_promo : int;
  debt_target : DebtTarget;
  cycles_ledger : int;
};
type AccountDelegateListReceivedResponse = record {
