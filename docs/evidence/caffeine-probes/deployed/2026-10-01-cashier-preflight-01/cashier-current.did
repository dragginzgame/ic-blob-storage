};
type StorageSetUsageBatchResult = variant {
  Ok : StorageSetUsageBatchResponse;
  Err : StorageSetUsageError;
};
type StorageSetUsageError = variant {
  NotAuthorized : principal;
  InternalError : text;
};
type StorageSetUsageRequest = record {
  owner : principal;
  usage : UsageCounters;
};
type SyncChange = variant {
  Delete : record { key : principal; entry_id : nat64 };
  Upsert : record { key : principal; entry_id : nat64 };
};
type SyncChangesRequest = record { since_seq : nat64; limit : nat64 };
type SyncChangesResponse = record {
  next_seq : nat64;
  changes : vec SyncChange;
};
type SyncSnapshotRequest = record { limit : nat64; after_key : opt principal };
type SyncValuesRequest = record { entry_ids : vec nat64 };
type SyntheticAuditLogRequest = record { seed : opt nat64; weeks : opt nat32 };
type SyntheticAuditLogResponse = record {
  bob : principal;
  eve : principal;
  alice : principal;
  carol : principal;
  dave : principal;
  weeks : nat32;
  entries_generated : nat32;
};
type SyntheticAuditLogResult = variant {
  Ok : SyntheticAuditLogResponse;
  Err : text;
};
type UsageCounters = record {
  bytes_downloaded : nat;
  bytes_uploaded : nat;
  write_requests : nat64;
  read_requests : nat64;
};
type UsageGauges = record {
  chunk_size_bytes : nat64;
  chunk_count : nat64;
  blob_count : nat64;
  blob_size_bytes : nat64;
};
type UsageLedgerGetRequest = record { owner : principal };
type UsageLedgerGetResponse = record {
  entries : vec record { text; UsageLedgerValue };
};
type UsageLedgerGetResult = variant {
  Ok : UsageLedgerGetResponse;
  Err : PricingError;
};
type UsageLedgerValue = record { quantity : Rational; cached_cost : Rational };
type UsagePrices = record {
  read_request_price : PricePerBillingUnit;
  bytes_downloaded_price : PricePerBillingUnit;
  bytes_uploaded_price : PricePerBillingUnit;
  write_request_price : PricePerBillingUnit;
};
type UserAccount = record {
  account_owner_id : principal;
  overdraft_limit : nat;
  top_up_without_attached_cycles_sum : nat;
  account_cycle_balance : AccountCycleBalances;
  last_top_up_ts_ns : nat64;
  relationship_removed_at_ns : opt nat64;
  past_counters : opt UsageCounters;
  creation_ts_ns : nat64;
  top_up_sum : nat;
  canister_api_version : opt nat8;
  target_balance : opt int;
  cycle_balance : int;
  gateways : opt vec record { GatewayId; UserGateway };
  storage_usage : UsageGauges;
  relationship_last_payment_account : opt principal;
  last_charge_ts_ns : nat64;
  last_top_up_without_attached_cycles_ts_ns : nat64;
};
type UserGateway = record {
  last_update_ns : nat64;
  usage_counters : opt UsageCounters;
};
type WebhookFormat = variant { Slack; Generic; PagerDuty };
type Whoami = record {
  id : text;
  account_cycle_balance : opt AccountCycleBalances;
  am_gateway : bool;
  am_admin : bool;
  cashier_principal : principal;
  am_anonymous : bool;
  caller_principal : principal;
};
service : {
  account_balance_get_v1 : (AccountGetRequest) -> (
      AccountBalanceGetResult,
    ) query;
  account_delegate_list_received_v1 : (opt principal) -> (
      AccountDelegateListReceivedResult,
    ) query;
  account_delegate_list_v1 : (opt principal) -> (
      AccountDelegateListResult,
    ) query;
  account_delegate_remove_v1 : (AccountDelegateRemoveRequest) -> (
      DelegationOperationResult,
    );
  account_delegate_set_v1 : (AccountDelegateSetRequest) -> (
      DelegationOperationResult,
    );
  account_info_get_v1 : (AccountGetRequest) -> (AccountInfoGetResult) query;
  account_settings_get_v1 : (AccountGetRequest) -> (
      AccountSettingsGetResult,
    ) query;
  account_settings_update_v1 : (AccountSettingsUpdateRequest) -> (
      AccountSettingsUpdateResult,
    );
  account_top_up_v1 : (opt AccountTopUpRequest) -> (AccountTopUpResult);
  accounts_list_v1 : (opt AccountsListPagedRequest) -> (
      AccountsListPagedResult,
    ) query;
  accounts_low_balance_list_v1 : () -> (AccountsLowBalanceListResult) query;
  admin_gateway_meta_list_v1 : () -> (AdminGatewayMetaListResult) query;
  admin_principal_add_v1 : (AdminPrincipalAddRequest) -> (
      AdminPrincipalAddResult,
    );
  admin_principal_list_v1 : () -> (AdminPrincipalListResult) query;
  admin_principal_remove_v1 : (AdminPrincipalAddRequest) -> (
      AdminPrincipalAddResult,
    );
  balance_histogram_v1 : () -> (BalanceHistogramResult) query;
  budget_check_v1 : (BudgetCheckRequest) -> (BudgetCheckResult) query;
  budget_get_v1 : (GetBudgetRequestV1) -> (GetBudgetResult) query;
  cached_balance_histogram_v1 : () -> (BalanceHistogramResult) query;
  charge_units_v1 : (BudgetCheckRequest) -> (ChargeUnitsResult);
  cycles_ledger_deposit_notify_v1 : (NotifyCyclesLedgerDepositRequest) -> (
      NotifyCyclesLedgerDepositResult,
    );
  cycles_ledger_deposit_subaccount_v1 : (
      CyclesLedgerDepositSubaccountRequest,
    ) -> (CyclesLedgerDepositSubaccountResponse) query;
  gateway_discover_v1 : (GatewayDiscoverRequest) -> (
      GatewayDiscoverResponse,
    ) query;
  gateway_tags_get_v1 : (principal) -> (GatewayTagsGetResult) query;
  gateway_tags_set_v1 : (GatewayTagsSetRequest) -> (GatewayTagsGetResult);
  gauge_histograms_compute_v1 : () -> (GaugeHistograms) query;
  gauge_histograms_set_v1 : () -> (GaugeHistograms);
  gauge_histograms_v1 : () -> (opt GaugeHistograms) query;
  notification_config_get_v1 : (AccountGetRequest) -> (
      NotificationConfigResult,
    ) query;
  notification_config_mark_notified_v1 : (
      NotificationConfigMarkNotifiedRequest,
    ) -> (NotificationConfigMarkNotifiedResult);
  notification_config_set_v1 : (NotificationConfigSetRequest) -> (
      NotificationConfigResult,
    );
  notification_configs_list_v1 : (opt principal, opt nat32) -> (
      NotificationConfigListResult,
    ) query;
  payment_account_audit_log_get_v1 : (AuditLogDownloadRequest) -> (
      AuditLogDownloadResult,
    ) query;
  payment_account_canister_add_v1 : (PaymentAccountCanisterAddRequest) -> (
      PaymentAccountOperationResult,
    );
  payment_account_canister_get_v1 : (PaymentAccountCanisterGetRequest) -> (
      PaymentAccountCanisterGetResult,
    ) query;
  payment_account_canister_list_v1 : (
      opt PaymentAccountCanisterListRequest,
    ) -> (PaymentAccountCanisterListResult) query;
  payment_account_canister_remove_v1 : (
      PaymentAccountCanisterRemoveRequest,
    ) -> (PaymentAccountOperationResult);
  payment_account_canister_update_v1 : (
      PaymentAccountCanisterUpdateRequest,
    ) -> (PaymentAccountOperationResult);
  payment_account_list_accessible_v1 : () -> (PaymentAccountListResult) query;
  payment_relationships_sync_changes_v1 : (SyncChangesRequest) -> (
      opt SyncChangesResponse,
    ) query;
  payment_relationships_sync_seq_v1 : () -> (nat64) query;
  payment_relationships_sync_snapshot_v1 : (SyncSnapshotRequest) -> (
      PayRelSyncSnapshotResponse,
    ) query;
  payment_relationships_sync_values_v1 : (SyncValuesRequest) -> (
      PayRelSyncValuesResponse,
    ) query;
  pricelist_get_v1 : () -> (PricelistGetResult) query;
  pricelist_remove_v1 : (PricelistRemoveRequest) -> (PricelistRemoveResult);
  pricelist_set_v1 : (PricelistSetRequest) -> (PricelistSetResult);
  pricelist_v1 : () -> (Pricelist) query;
  service_gateway_add_v1 : (ServiceGatewayAddRequest) -> (
      ServiceGatewayAddResult,
    );
  service_gateway_list_v1 : (ServiceGatewayListRequest) -> (
      vec principal,
    ) query;
  service_gateway_remove_v1 : (ServiceGatewayRemoveRequest) -> (
      ServiceGatewayAddResult,
    );
  storage_canister_api_version_get_v1 : (PaymentAccountCanisterGetRequest) -> (
      opt nat8,
    ) query;
  storage_canister_api_version_set_v1 : (
      StorageSetCanisterApiVersionRequest,
    ) -> (StorageSetCanisterApiVersionResult);
  storage_gateway_add_v1 : (StorageGatewayAddRequest) -> (
      ServiceGatewayAddResult,
    );
  storage_gateway_list_v1 : () -> (vec principal) query;
  storage_gateway_principal_list_v1 : () -> (vec principal) query;
  storage_gateway_remove_v1 : (StorageGatewayAddRequest) -> (
      ServiceGatewayAddResult,
    );
  storage_gauges_set_v1 : (StorageSetGaugesRequest) -> (StorageSetGaugesResult);
  storage_usage_set_batch_v1 : (StorageSetUsageBatchRequest) -> (
      StorageSetUsageBatchResult,
    );
  usage_ledger_get_v1 : (UsageLedgerGetRequest) -> (UsageLedgerGetResult) query;
  whoami : () -> (Whoami) query;
  zz_generate_synthetic_audit_log_v1 : (SyntheticAuditLogRequest) -> (
      SyntheticAuditLogResult,
    );
  zz_simulate_consumption_v1 : (principal, nat) -> (SimulateConsumptionResult);
  zz_top_up_promo_cycles_v1 : (principal, nat) -> (AccountTopUpResult);
  zz_trigger_auto_topup_v1 : () -> (text);
}
