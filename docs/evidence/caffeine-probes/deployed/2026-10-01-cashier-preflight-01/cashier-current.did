  Err : AdminPrincipalAddError;
};
type AuditEventType = variant {
  Spend;
  RelationshipAdd;
  RelationshipUpdate;
  LedgerDeposit;
  TopUp;
  RelationshipRemove;
  UnitCharge;
};
type AuditLogContinuationToken = record {
  account : opt principal;
  sequence : nat64;
};
type AuditLogDownloadRequest = record {
  continuation_token : opt AuditLogContinuationToken;
  max_entries : opt nat64;
  account : opt principal;
  event_type : opt AuditEventType;
};
type AuditLogDownloadResponse = record {
  continuation_token : opt AuditLogContinuationToken;
  csv_content : text;
  num_returned_entries : nat64;
  has_more : bool;
};
type AuditLogDownloadResult = variant {
  Ok : AuditLogDownloadResponse;
  Err : AuditLogError;
};
type AuditLogError = variant {
  NotAuthorized : principal;
  InvalidRequest : text;
  InternalError : text;
};
type BalanceHistogram = record { sum : int; buckets : vec nat64 };
type BalanceHistogramError = variant { NotAuthorized : principal };
type BalanceHistogramResult = variant {
  Ok : BalanceHistogram;
  Err : BalanceHistogramError;
};
type BudgetCheckRequest = record {
  owner : principal;
  units : vec record { text; Rational };
};
type BudgetCheckResponse = record {
  available_budget : int;
  approved : bool;
  estimated_cost : Rational;
};
type BudgetCheckResult = variant {
  Ok : BudgetCheckResponse;
  Err : PricingError;
};
type CashierArgs = record {
  overdraft_limit : opt nat;
  gateway_principals : opt vec principal;
};
type CashierInternalError = variant {
  AccountNotFound;
  OperationFailed : text;
  InsufficientBalance : record { needed : nat; available : int };
  InsufficientCycles : record {
    description : text;
    available : int;
    required : int;
  };
  NotAuthorized : principal;
  InvalidArgument : text;
  AccountBalanceOverflow;
  TopUpWithoutCycles;
};
type ChargeUnitsResponse = record {
  remaining_operations : opt Rational;
  charged_cost : Rational;
};
type ChargeUnitsResult = variant {
  Ok : ChargeUnitsResponse;
  Err : PricingError;
};
type CyclesLedgerDepositSubaccountRequest = record { sender : principal };
type CyclesLedgerDepositSubaccountResponse = record { subaccount : blob };
type DebtTarget = variant { Prepaid; Ledger };
type Delegation = record {
  permissions : vec DelegationPermission;
  delegate : principal;
  created_at : nat64;
  valid_until : opt nat64;
};
type DelegationError = variant {
  DelegationNotFound : principal;
  NotAuthorized : principal;
  InvalidRequest : text;
  InternalError : text;
};
type DelegationOperationResult = variant { Ok; Err : DelegationError };
type DelegationPermission = variant { ReadOnly; FullAccess };
type Factor = variant { G; K; M; T; U; Gi; Ki; Mi; Ti };
type GatewayBudget = record { available_credit : int };
type GatewayDiscoverRequest = record {
  tags : opt vec text;
  gateway_type : opt GatewayType;
};
type GatewayDiscoverResponse = record { gateways : vec GatewayInfo };
type GatewayId = record { "principal" : principal; name : opt text };
type GatewayInfo = record {
  "principal" : principal;
  tags : vec text;
  gateway_type : GatewayType;
};
type GatewayMetadata = record {
  last_seen_ns : opt nat64;
  gateway_id : GatewayId;
  active_since_last_garbage_collection : bool;
};
type GatewayTagsError = variant {
  InvalidInput : text;
  NotAuthorized : principal;
  GatewayNotFound : principal;
  InternalError : text;
};
type GatewayTagsGetResult = variant { Ok : vec text; Err : GatewayTagsError };
type GatewayTagsSetRequest = record {
  gateway_principal : principal;
  tags : vec text;
};
type GatewayType = variant { Email; Storage };
type GaugeHistograms = record {
  chunk_size_bytes : Histogram;
  chunk_count : Histogram;
  blob_count : Histogram;
  blob_size_bytes : Histogram;
};
type GetBudgetError = variant { GatewayNotFound : GatewayId; OwnerNotFound };
type GetBudgetRequestV1 = record {
  gateway_id : opt GatewayId;
  owner_id : principal;
};
type GetBudgetResponseV1 = record {
  usage : UsageCounters;
  budget : GatewayBudget;
};
type GetBudgetResult = variant {
  Ok : GetBudgetResponseV1;
  Err : GetBudgetError;
};
type Histogram = record {
  name : text;
  labels : vec text;
  sums : vec nat;
  bounds : vec nat64;
  counts : vec nat64;
};
type LevelPrices = record { bytes_stored : PricePerBillingUnit };
type NotificationConfig = record {
  webhook_url : opt text;
  last_notified_low_at : opt nat64;
  low_balance_threshold_cycles : opt int;
  critical_balance_threshold_cycles : opt int;
  webhook_format : WebhookFormat;
  last_notified_critical_at : opt nat64;
};
type NotificationConfigError = variant {
  AccountNotFound;
  NotAuthorized : principal;
  InvalidRequest : text;
  InternalError : text;
};
type NotificationConfigListResponse = record {
  configs : vec record { principal; NotificationConfig };
  next_cursor : opt principal;
};
type NotificationConfigListResult = variant {
  Ok : NotificationConfigListResponse;
  Err : NotificationConfigError;
};
type NotificationConfigMarkNotifiedRequest = record {
  critical_accounts : vec principal;
  resolved_accounts : vec principal;
  low_accounts : vec principal;
};
type NotificationConfigMarkNotifiedResponse = record { updated : nat32 };
type NotificationConfigMarkNotifiedResult = variant {
  Ok : NotificationConfigMarkNotifiedResponse;
  Err : NotificationConfigError;
};
type NotificationConfigResult = variant {
  Ok : NotificationConfig;
  Err : NotificationConfigError;
};
type NotificationConfigSetRequest = record {
  webhook_url : opt text;
  clear : opt bool;
  low_balance_threshold_cycles : opt int;
  account : opt principal;
  critical_balance_threshold_cycles : opt int;
  webhook_format : opt WebhookFormat;
};
type NotifyCyclesLedgerDepositError = variant {
  SweepFailed : record { message : text };
  NothingToDeposit;
  InternalError : record { message : text };
  DepositTooSmall : record { fee : nat; balance : nat };
};
type NotifyCyclesLedgerDepositRequest = record { account : opt principal };
type NotifyCyclesLedgerDepositResponse = record {
  balance : AccountCycleBalances;
  ledger_block_index : nat;
  credited : nat;
};
type NotifyCyclesLedgerDepositResult = variant {
  Ok : NotifyCyclesLedgerDepositResponse;
  Err : NotifyCyclesLedgerDepositError;
};
type PayRelSyncSnapshotEntry = record {
  key : principal;
  value : PaymentRelationship;
  entry_id : nat64;
};
type PayRelSyncSnapshotResponse = record {
  entries : vec PayRelSyncSnapshotEntry;
  current_seq : nat64;
};
type PayRelSyncValueEntry = record {
  value : PaymentRelationship;
  entry_id : nat64;
};
type PayRelSyncValuesResponse = record { values : vec PayRelSyncValueEntry };
type PaymentAccountCanisterAddRequest = record {
  spending_limit_per_day : int;
  paid_canister : principal;
  expiration_timestamp : opt nat64;
  payment_account : opt principal;
};
type PaymentAccountCanisterGetRequest = record { canister : principal };
type PaymentAccountCanisterGetResponse = record {
  relationship : opt PaymentRelationship;
};
type PaymentAccountCanisterGetResult = variant {
  Ok : PaymentAccountCanisterGetResponse;
  Err : PaymentAccountError;
};
type PaymentAccountCanisterListRequest = record {
  continuation_token : opt principal;
  max_results : opt nat32;
  payment_account : opt principal;
};
type PaymentAccountCanisterListResponse = record {
  next_continuation_token : opt principal;
  relationships : vec PaymentRelationship;
};
type PaymentAccountCanisterListResult = variant {
  Ok : PaymentAccountCanisterListResponse;
  Err : PaymentAccountError;
};
type PaymentAccountCanisterRemoveRequest = record {
  paid_canister : principal;
  payment_account : opt principal;
};
type PaymentAccountCanisterUpdateRequest = record {
  spending_limit_per_day : opt int;
  paid_canister : principal;
  expiration_timestamp : opt opt nat64;
  payment_account : opt principal;
};
type PaymentAccountError = variant {
  RelationshipNotFound : principal;
  NotAuthorized : principal;
  InvalidRequest : text;
  InternalError : text;
};
type PaymentAccountListResponse = record { payment_accounts : vec principal };
type PaymentAccountListResult = variant {
  Ok : PaymentAccountListResponse;
  Err : PaymentAccountError;
};
type PaymentAccountOperationResult = variant { Ok; Err : PaymentAccountError };
type PaymentRelationship = record {
  added_timestamp : nat64;
  spending_limit_per_day : int;
  paid_canister : principal;
  bandwidth_baseline_downloaded : nat;
  expiration_timestamp : opt nat64;
  current_period_spent : int;
  current_period_start : nat64;
  bandwidth_baseline_ts_ns : nat64;
  payment_account : principal;
  bandwidth_baseline_uploaded : nat;
};
type PricePerBillingUnit = record { per : Factor; cost : int };
type Pricelist = record { gauges : LevelPrices; counters : UsagePrices };
type PricelistGetResponse = record { units : vec record { text; PricingUnit } };
type PricelistGetResult = variant {
  Ok : PricelistGetResponse;
  Err : PricingError;
};
type PricelistRemoveRequest = record { key : text };
type PricelistRemoveResult = variant { Ok; Err : PricingError };
type PricelistSetRequest = record { key : text; unit : PricingUnit };
type PricelistSetResult = variant { Ok : text; Err : PricingError };
type PricingConversion = variant {
  Unit : record { rate : Rational; target : text };
  Terminal;
};
type PricingError = variant {
  UnitNotFound : text;
  AccountNotFound;
  InvalidQuantity : text;
  UnitInUse : text;
  TerminalUnit : text;
  BrokenChain : text;
  NotAuthorized;
  InvalidRate : text;
  ChainTooDeep;
  InvalidUnitName : text;
  InternalError : text;
  UnitMismatch : record { left : text; right : text };
};
type PricingUnit = record {
  description : text;
  conversion : PricingConversion;
};
type Rational = record { numerator : int; denominator : int };
type ServiceGatewayAddRequest = record {
  gateway_principal : principal;
  gateway_type : GatewayType;
};
type ServiceGatewayAddResponse = record {
  gateway_principal : principal;
  message : text;
};
type ServiceGatewayAddResult = variant {
  Ok : ServiceGatewayAddResponse;
  Err : AdminPrincipalAddError;
};
type ServiceGatewayListRequest = record { gateway_type : opt GatewayType };
type ServiceGatewayRemoveRequest = record { gateway_principal : principal };
type SimulateConsumptionResult = variant { Ok; Err : text };
type StorageGatewayAddRequest = record { gateway_principal : principal };
type StorageSetCanisterApiVersionError = variant {
  NotAuthorized : principal;
  InvalidVersion : nat8;
};
type StorageSetCanisterApiVersionRequest = record {
  versions : vec record { principal; nat8 };
};
type StorageSetCanisterApiVersionResult = variant {
  Ok;
  Err : StorageSetCanisterApiVersionError;
};
